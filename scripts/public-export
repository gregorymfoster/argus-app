#!/usr/bin/env bash
# Copy main's current tree, minus everything private, into a public snapshot repo.
# The private repo keeps its full history (and Greg's bench photos); the public repo only ever
# sees snapshots of HEAD, so nothing private can leak through an old commit.
#   scripts/public-export DIR     DIR empty or missing: a fresh repo with one commit.
#                                 DIR a clone of the public repo: one new "Sync" commit on top.
# It never pushes: check DIR, then `git -C DIR push` yourself. The public repo is
# github.com/gregorymfoster/argus-app (Greg, 2026-10-19); see README "Build from source".
set -euo pipefail
cd "$(dirname "$0")/.."
dest="${1:?usage: scripts/public-export DIR}"

# Private: Greg's photos and Lightroom data (bench fixtures, goldens rendered from his RAWs)
# and the bench tooling that reads his catalog. Add a path here before it can go public.
PRIVATE=(
  fixtures/bench
  fixtures/golden
  .claude/skills/bench-report
  docs/blog
)
# All of bench/ but the speed baseline, so a new bench script stays private by default.
KEEP_IN_BENCH=speed-baseline.json

sha=$(git rev-parse --short HEAD)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git archive HEAD | tar -x -C "$tmp"
for p in "${PRIVATE[@]}"; do rm -rf "${tmp:?}/$p"; done
find "$tmp/bench" -mindepth 1 -maxdepth 1 -not -name "$KEEP_IN_BENCH" -exec rm -rf {} +

# Leak check: no photos outside the app icons and the README's media, no personal paths or addresses.
# docs/media/ holds README screenshots of the public-domain sample card only: each file there must be
# named on CREDITS.md's "Files:" line, so a photo dropped in by mistake still fails.
leaks=$(cd "$tmp" && find . -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.arw' \
  -o -iname '*.dng' -o -iname '*.heic' -o -iname '*.tif*' -o -iname '*.webp' -o -iname '*.db' -o -iname '*.mcat' \) \
  -not -path './app/icons/*' -not -path './docs/media/*' | sort)
credited=$(grep -m1 '^Files:' "$tmp/docs/media/CREDITS.md" 2>/dev/null | tr ' ,' '\n\n' || true)
for f in $(cd "$tmp" && find docs/media -type f -not -name CREDITS.md 2>/dev/null); do
  grep -qxF "$(basename "$f")" <<<"$credited" || leaks="$leaks $f"
done
words=$(grep -rlE --exclude=public-export 'gregorymfoster@gmail|GoogleDrive-|/Users/gregfoster|lrlibrary' "$tmp" | sed "s|$tmp/||" | sort || true)
if [ -n "$leaks$words" ]; then
  echo "public-export: private files or text left in the tree, add them to PRIVATE or scrub them:" >&2
  printf '%s\n' $leaks $words >&2
  exit 1
fi

mkdir -p "$dest"
if [ ! -d "$dest/.git" ]; then
  [ -z "$(ls -A "$dest")" ] || { echo "public-export: $dest is not empty and not a git repo" >&2; exit 1; }
  git -C "$dest" init -q -b main
fi
# Replace the snapshot's contents wholesale, keeping only its .git.
find "$dest" -mindepth 1 -maxdepth 1 -not -name .git -exec rm -rf {} +
cp -a "$tmp/." "$dest/"
git -C "$dest" add -A
if git -C "$dest" diff --cached --quiet; then
  echo "public-export: $dest already matches $sha"
  exit 0
fi
msg="Argus at $sha"
git -C "$dest" rev-parse -q --verify HEAD >/dev/null && msg="Sync from $sha"
git -C "$dest" commit -q -m "$msg"
echo "public-export: $dest has \"$msg\" ($(git -C "$dest" ls-files | wc -l) files); push it with git -C $dest push"
