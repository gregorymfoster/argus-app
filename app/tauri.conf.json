{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus",
  "version": "0.0.1",
  "identifier": "com.gregorymfoster.argus",
  "build": {
    "frontendDist": "../prototype/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm install --no-audit --no-fund && npm run dev",
      "cwd": "../prototype"
    },
    "beforeBuildCommand": {
      "script": "../scripts/cached prototype-build --in prototype --out prototype/dist/index.html -- sh -c 'npm install --no-audit --no-fund && npm run build'",
      "cwd": "../prototype"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Argus",
        "url": "index.html#/cull",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.photography",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
